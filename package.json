{
  "name": "colord",
  "version": "2.12.0",
  "description": "👑 A tiny yet powerful JavaScript library for high-performance color manipulations and conversions",
  "keywords": [
    "color",
    "javascript",
    "parser",
    "convert",
    "tiny",
    "hex",
    "rgb",
    "hsl",
    "hsv",
    "hwb",
    "lab",
    "lch",
    "xyz",
    "css",
    "color-names",
    "a11y",
    "cmyk",
    "mix",
    "minify",
    "harmonies"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omgovich/colord.git"
  },
  "author": "Vlad Shilov <omgovich@ya.ru>",
  "license": "MIT",
  "sideEffects": false,
  "main": "./index.js",
  "module": "./index.mjs",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.js",
      "default": "./index.mjs"
    },
    "./plugins/a11y": {
      "import": {
        "types": "./plugins/a11y.d.mts",
        "default": "./plugins/a11y.mjs"
      },
      "types": "./plugins/a11y.d.ts",
      "require": "./plugins/a11y.js",
      "default": "./plugins/a11y.mjs"
    },
    "./plugins/cmyk": {
      "import": {
        "types": "./plugins/cmyk.d.mts",
        "default": "./plugins/cmyk.mjs"
      },
      "types": "./plugins/cmyk.d.ts",
      "require": "./plugins/cmyk.js",
      "default": "./plugins/cmyk.mjs"
    },
    "./plugins/harmonies": {
      "import": {
        "types": "./plugins/harmonies.d.mts",
        "default": "./plugins/harmonies.mjs"
      },
      "types": "./plugins/harmonies.d.ts",
      "require": "./plugins/harmonies.js",
      "default": "./plugins/harmonies.mjs"
    },
    "./plugins/hwb": {
      "import": {
        "types": "./plugins/hwb.d.mts",
        "default": "./plugins/hwb.mjs"
      },
      "types": "./plugins/hwb.d.ts",
      "require": "./plugins/hwb.js",
      "default": "./plugins/hwb.mjs"
    },
    "./plugins/lab": {
      "import": {
        "types": "./plugins/lab.d.mts",
        "default": "./plugins/lab.mjs"
      },
      "types": "./plugins/lab.d.ts",
      "require": "./plugins/lab.js",
      "default": "./plugins/lab.mjs"
    },
    "./plugins/lch": {
      "import": {
        "types": "./plugins/lch.d.mts",
        "default": "./plugins/lch.mjs"
      },
      "types": "./plugins/lch.d.ts",
      "require": "./plugins/lch.js",
      "default": "./plugins/lch.mjs"
    },
    "./plugins/minify": {
      "import": {
        "types": "./plugins/minify.d.mts",
        "default": "./plugins/minify.mjs"
      },
      "types": "./plugins/minify.d.ts",
      "require": "./plugins/minify.js",
      "default": "./plugins/minify.mjs"
    },
    "./plugins/mix": {
      "import": {
        "types": "./plugins/mix.d.mts",
        "default": "./plugins/mix.mjs"
      },
      "types": "./plugins/mix.d.ts",
      "require": "./plugins/mix.js",
      "default": "./plugins/mix.mjs"
    },
    "./plugins/names": {
      "import": {
        "types": "./plugins/names.d.mts",
        "default": "./plugins/names.mjs"
      },
      "types": "./plugins/names.d.ts",
      "require": "./plugins/names.js",
      "default": "./plugins/names.mjs"
    },
    "./plugins/oklab": {
      "import": {
        "types": "./plugins/oklab.d.mts",
        "default": "./plugins/oklab.mjs"
      },
      "types": "./plugins/oklab.d.ts",
      "require": "./plugins/oklab.js",
      "default": "./plugins/oklab.mjs"
    },
    "./plugins/oklch": {
      "import": {
        "types": "./plugins/oklch.d.mts",
        "default": "./plugins/oklch.mjs"
      },
      "types": "./plugins/oklch.d.ts",
      "require": "./plugins/oklch.js",
      "default": "./plugins/oklch.mjs"
    },
    "./plugins/xyz": {
      "import": {
        "types": "./plugins/xyz.d.mts",
        "default": "./plugins/xyz.mjs"
      },
      "types": "./plugins/xyz.d.ts",
      "require": "./plugins/xyz.js",
      "default": "./plugins/xyz.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "*.{js,mjs,ts,map}",
    "plugins/*.{js,mjs,ts,map}",
    "**/*.d.ts",
    "plugins/*.d.mts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE.md"
  ],
  "types": "index.d.ts",
  "scripts": {
    "lint": "eslint src/**/*.ts",
    "size": "npm run build && size-limit",
    "check-types": "node node_modules/typescript/bin/tsc --noEmit true",
    "check-dist-types": "npm run build && node tests/dist-types/check.mjs",
    "test": "jest tests --coverage",
    "benchmark": "node node_modules/typescript/bin/tsc --outDir bench --skipLibCheck --esModuleInterop ./tests/benchmark.ts && node ./bench/tests/benchmark.js; code=$?; rm -rf ./bench; exit $code",
    "build": "rm -rf ./dist/* && rollup --config",
    "release": "npm run build && cp *.json dist && cp *.md dist && npm publish ./dist",
    "check-release": "npm run release -- --dry-run",
    "changeset:version": "changeset version && npm install --package-lock-only --ignore-scripts",
    "changeset:publish": "(npm view colord@$npm_package_version version >/dev/null 2>&1 || npm run release) && changeset git-tag"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@size-limit/preset-small-lib": "^11.2.0",
    "@types/jest": "^26.0.22",
    "@typescript-eslint/eslint-plugin": "^4.19.0",
    "@typescript-eslint/parser": "^4.19.0",
    "ac-colors": "^1.4.2",
    "benny": "^3.6.15",
    "chroma-js": "^2.1.1",
    "color": "^3.1.3",
    "eslint": "^7.14.0",
    "eslint-config-prettier": "^6.15.0",
    "eslint-plugin-prettier": "^3.1.4",
    "glob": "^7.1.6",
    "jest": "^26.6.3",
    "prettier": "^2.2.0",
    "rollup": "^2.80.0",
    "rollup-plugin-terser": "^7.0.2",
    "rollup-plugin-typescript2": "^0.36.0",
    "size-limit": "^11.2.0",
    "tinycolor2": "^1.4.2",
    "ts-jest": "^26.5.4",
    "ts-node": "^9.1.1",
    "tslib": "^2.1.0",
    "typescript": "^4.2.3",
    "typescript-5": "npm:typescript@5.9.3"
  },
  "jest": {
    "verbose": true,
    "transform": {
      "^.+\\.ts$": "ts-jest"
    }
  },
  "eslintConfig": {
    "plugins": [
      "prettier"
    ],
    "extends": [
      "eslint:recommended",
      "plugin:@typescript-eslint/eslint-recommended",
      "plugin:@typescript-eslint/recommended",
      "plugin:prettier/recommended",
      "prettier/@typescript-eslint"
    ]
  },
  "prettier": {
    "printWidth": 100
  },
  "size-limit": [
    {
      "path": "dist/index.mjs",
      "import": "{ colord }",
      "limit": "2 KB"
    },
    {
      "path": "dist/plugins/a11y.mjs",
      "limit": "0.5 KB"
    },
    {
      "path": "dist/plugins/cmyk.mjs",
      "limit": "1 KB"
    },
    {
      "path": "dist/plugins/harmonies.mjs",
      "limit": "0.5 KB"
    },
    {
      "path": "dist/plugins/hwb.mjs",
      "limit": "1 KB"
    },
    {
      "path": "dist/plugins/lab.mjs",
      "limit": "1.5 KB"
    },
    {
      "path": "dist/plugins/lch.mjs",
      "limit": "1.5 KB"
    },
    {
      "path": "dist/plugins/minify.mjs",
      "limit": "0.6 KB"
    },
    {
      "path": "dist/plugins/mix.mjs",
      "limit": "1.1 KB"
    },
    {
      "path": "dist/plugins/names.mjs",
      "limit": "1.5 KB"
    },
    {
      "path": "dist/plugins/oklab.mjs",
      "limit": "1.5 KB"
    },
    {
      "path": "dist/plugins/oklch.mjs",
      "limit": "1.5 KB"
    },
    {
      "path": "dist/plugins/xyz.mjs",
      "limit": "1 KB"
    }
  ]
}
